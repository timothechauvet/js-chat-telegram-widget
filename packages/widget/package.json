{
  "name": "js-chat-telegram-widget",
  "version": "1.2.1",
  "type": "module",
  "description": "Zero-dependency, framework-agnostic Custom Element live chat widget connected to Telegram",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "unpkg": "dist/index.mjs",
  "jsdelivr": "dist/index.mjs",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothechauvet/js-chat-telegram-widget.git"
  },
  "homepage": "https://github.com/timothechauvet/js-chat-telegram-widget#readme",
  "bugs": {
    "url": "https://github.com/timothechauvet/js-chat-telegram-widget/issues"
  },
  "author": "Timothé Chauvet <timothe@chauvet.dev>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "telegram",
    "livechat",
    "widget",
    "web-components",
    "custom-element",
    "customer-support",
    "chat-widget"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
